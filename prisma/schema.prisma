generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  INTERVIEW
  ARTICLE
  VIDEO
}

model Category {
  slug     String    @id
  name     String
  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  categorySlug      String
  category          Category @relation(fields: [categorySlug], references: [slug])
  shortDescription  String
  description       String
  material          String?
  dimensions        String?
  images            String[]
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([categorySlug])
  @@index([featured])
  @@index([createdAt])
}

model Award {
  id          String   @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model MediaFeature {
  id        String    @id @default(cuid())
  title     String
  outlet    String
  year      String
  type      MediaType
  url       String?
  sortOrder Int       @default(0)
  updatedAt DateTime  @updatedAt
}

/// Singleton row (id is always "singleton") holding homepage copy.
model HomeContent {
  id                       String   @id @default("singleton")
  heroEyebrow              String
  heroName                 String
  heroSubtitle             String
  heroCtaLabel             String
  heroCtaHref              String
  heroImage                String?
  aboutPreviewEyebrow      String
  aboutPreviewHeading      String
  aboutPreviewBody         String
  aboutPreviewCtaLabel     String
  aboutPreviewCtaHref      String
  featuredEyebrow          String
  featuredTitle            String
  featuredDescription      String
  featuredCtaLabel         String
  featuredCtaHref          String
  craftsmanshipEyebrow     String
  craftsmanshipTitle       String
  /// Array of { title, description, icon } objects.
  craftsmanshipValues      Json
  updatedAt                DateTime @updatedAt
}

/// Singleton row (id is always "singleton") holding about-page copy.
model AboutContent {
  id                      String   @id @default("singleton")
  heroEyebrow             String
  heroTitle               String
  artisanImage            String?
  journeyEyebrow          String
  journeyHeading          String
  journeyParagraphs       String[]
  craftsmanshipEyebrow    String
  craftsmanshipTitle      String
  craftsmanshipDescription String
  craftsmanshipParagraphs String[]
  updatedAt               DateTime @updatedAt
}

/// Singleton row (id is always "singleton") holding general site settings.
model SiteConfig {
  id               String   @id @default("singleton")
  name             String
  shortName        String
  tagline          String
  description      String
  phone            String
  phoneDisplay     String
  whatsappNumber   String
  addressLine1     String
  addressLine2     String
  addressLine3     String
  footerDescription String
  updatedAt        DateTime @updatedAt
}
